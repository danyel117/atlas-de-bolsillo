# Public endpoints for your Convex deployment. npx convex dev creates .env.local.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
# Configure BETTER_AUTH_SECRET, SITE_URL, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
# RESEND_API_KEY and EMAIL_FROM using `npx convex env set`, never as VITE_ variables.
